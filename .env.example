# Copie para .env e preencha. O .env fica fora do git.

# Postgres. Local, Neon, Supabase ou qualquer outro.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/alicia?schema=public"

# Chave usada para assinar as sessões. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Endereço público do site (usado nos retornos do pagamento).
APP_URL="http://localhost:5173"

# Mercado Pago. Comece pelas credenciais de TESTE do painel de
# desenvolvedores. O token nunca vai para o front-end.
MERCADOPAGO_ACCESS_TOKEN=""
# Definido ao cadastrar o webhook no painel; valida a assinatura das notificações.
MERCADOPAGO_WEBHOOK_SECRET=""
